{
  "name": "chooser-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.12.1"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/release/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fsd:check": "node scripts/architecture/check.mjs",
    "legal:check": "node scripts/legal/check.mjs",
    "legal:inventory": "node scripts/legal/generate-dependency-inventory.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "verify": "node scripts/verify.mjs",
    "deploy": "node scripts/release/deploy.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "astro": "7.4.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
