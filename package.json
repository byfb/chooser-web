{
  "name": "chooser-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.12.1"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/release/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fsd:check": "steiger ./src && node scripts/architecture/check.mjs",
    "legal:check": "node scripts/legal/check.mjs",
    "legal:inventory": "node scripts/legal/generate-dependency-inventory.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "verify": "node scripts/verify.mjs",
    "deploy": "node scripts/release/deploy.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.5",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "astro": "7.2.10",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "steiger": "0.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
